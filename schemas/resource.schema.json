{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Threat Modeling library resource",
  "type": "object",
  "required": [
    "id",
    "title",
    "url",
    "authors",
    "type",
    "topics",
    "access",
    "grade",
    "level",
    "lang",
    "summary",
    "limit",
    "origin",
    "added",
    "featured"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,59}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "authors": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1960
    },
    "type": {
      "enum": [
        "manifesto",
        "guide",
        "method",
        "book",
        "paper",
        "article",
        "conference",
        "course",
        "tool",
        "dataset"
      ]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "threat-modeling",
          "detection-engineering",
          "cti",
          "apt",
          "ai",
          "ics-cps",
          "privacy",
          "psychology",
          "emulation",
          "provenance",
          "cloud",
          "supply-chain",
          "attack-graphs",
          "risk",
          "architecture",
          "research-methods"
        ]
      }
    },
    "access": {
      "enum": [
        "free",
        "open-access",
        "preprint",
        "mixed",
        "paid"
      ]
    },
    "grade": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "level": {
      "enum": [
        "intro",
        "intermediate",
        "advanced"
      ]
    },
    "lang": {
      "enum": [
        "en",
        "pt"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "acervo",
        "bibliografia",
        "catalogo",
        "conferencias",
        "curadoria",
        "engenharia",
        "notion",
        "referencial",
        "referencias"
      ]
    },
    "added": {
      "type": "string",
      "format": "date"
    },
    "checked": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "featured": {
      "type": "boolean"
    },
    "exercise": {
      "type": "string"
    },
    "doi": {
      "type": "string",
      "pattern": "^10\\.\\d{4,9}/\\S+$",
      "description": "DOI sem prefixo https://doi.org/"
    },
    "venue": {
      "type": "string",
      "minLength": 1,
      "description": "Periódico, evento, editora ou órgão emissor, com volume, número e páginas quando houver"
    },
    "isbn": {
      "type": "string",
      "pattern": "^[0-9Xx-]{10,17}$"
    },
    "essential": {
      "type": "boolean",
      "description": "Faz parte do núcleo essencial de leitura"
    }
  },
  "additionalProperties": false
}
