{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Threat Modeling library method",
  "type": "object",
  "required": [
    "id",
    "name",
    "approach",
    "question",
    "centered_on",
    "outputs",
    "use_when",
    "limits",
    "status",
    "resources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,59}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "approach": {
      "enum": [
        "arquitetura",
        "atacante",
        "ia",
        "inteligência",
        "privacidade",
        "processo",
        "risco",
        "simulação",
        "software"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "centered_on": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "string",
      "minLength": 1
    },
    "use_when": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "core",
        "emerging",
        "complementary",
        "legacy"
      ]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "psychology": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
